# EDITH · LOCAL DEVELOPMENT
# Run npm run setup to create .env and generate the auth secret automatically.

# DATABASE — use this only if MongoDB is installed locally.
# For Atlas: Connect > Drivers > copy the connection string; see ../SETUP.md.
MONGO_URI=mongodb://127.0.0.1:27017/edith

# GENERATED LOCALLY by npm run setup. Never get this from a provider.
BETTER_AUTH_SECRET=

# LOCAL DEFAULTS — leave these unchanged and open http://localhost:5173.
PORT=5000
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# OPTIONAL: GOOGLE — Google Cloud > Google Auth Platform > Clients > Web application.
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL: ULTRON AI — create a Gemini API key at https://aistudio.google.com/apikey
# This is separate from the Google OAuth client used for login.
GEMINI_API_KEY=
# Optional model override. The default supports images, structured outputs, and tools.
GEMINI_MODEL=gemini-3.5-flash-lite

# EMAIL - Resend HTTPS API. Required in production; optional for local development.
# Get a sending API key at https://resend.com/api-keys (backend only).
RESEND_API_KEY=
# Use an address on a domain you verified in Resend, e.g. Edith <hello@yourdomain.com>.
RESEND_FROM_EMAIL=

# HOSTING ONLY — keep 0 locally. Set 1 only behind a trusted reverse proxy.
TRUST_PROXY=0
