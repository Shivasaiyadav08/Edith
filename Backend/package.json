    "@clerk/express": "^2.1.82",
    "ai": "^7.0.148",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "mongoose": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
