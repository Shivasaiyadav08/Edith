# Local MongoDB or your Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/edith
PORT=5000
FRONTEND_URL=http://localhost:5173

# Clerk Dashboard > API Keys. Use keys from the same Clerk instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Ultron AI: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Set 1 only behind your hosting provider's trusted reverse proxy.
TRUST_PROXY=0
